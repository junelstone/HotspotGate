{
  "//": "Type-checks the shared code and the Node test driver (the Deno entry point index.ts is checked by `supabase functions deploy`).",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "lib": ["es2022", "dom"],
    "types": ["node"]
  },
  "include": ["supabase/functions/_shared/*.ts", "tests/*.ts"]
}
