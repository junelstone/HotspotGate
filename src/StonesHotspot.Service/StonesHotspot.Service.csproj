<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>StonesHotspot.Service</RootNamespace>
    <AssemblyName>StonesHotspot.Service</AssemblyName>
    <OutputType>Exe</OutputType>
    <!-- Installed as a Windows Service on win-x64 (see build.ps1 -Publish). -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StonesHotspot.Core\StonesHotspot.Core.csproj" />
    <ProjectReference Include="..\StonesHotspot.Licensing\StonesHotspot.Licensing.csproj" />
    <ProjectReference Include="..\StonesHotspot.Network\StonesHotspot.Network.csproj" />
    <ProjectReference Include="..\StonesHotspot.Web\StonesHotspot.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StonesHotspot.Tests" />
  </ItemGroup>

  <!-- WinDivert driver next to the service (downloaded by tools/Get-WinDivert.ps1, not in Git). -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\WinDivert\x64\WinDivert.dll')">
    <None Include="$(MSBuildThisFileDirectory)..\..\third_party\WinDivert\x64\WinDivert.dll" Link="WinDivert.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\third_party\WinDivert\x64\WinDivert64.sys" Link="WinDivert64.sys" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)..\..\third_party\WinDivert\LICENSE" Link="WinDivert-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.Local.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
