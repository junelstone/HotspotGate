@page "/setup"
@model StonesHotspot.Web.Pages.SetupModel
@{
    ViewData["Title"] = Strings.Setup_Title;
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    string[] steps = [Strings.Setup_StepLanguage, Strings.Setup_StepBusiness, Strings.Setup_StepPassword, Strings.Setup_StepNetwork, Strings.Setup_StepPlans, Strings.Setup_StepDone];
}
<div style="max-width:560px;margin:1rem auto">
    <h1>@Strings.Setup_Title</h1>
    @if (Model.Remote)
    {
        <div class="msg warning">@Strings.Setup_OnThePc</div>
        return;
    }
    <p class="muted">@string.Format(Strings.Setup_StepOf, Model.Step, SetupModel.LastStep) — <strong>@steps[Model.Step - 1]</strong></p>
    @if (Model.Error is not null)
    {
        <div class="msg error" role="alert">@Model.Error</div>
    }
    @foreach (var p in Model.NetworkProblems)
    {
        <div class="msg @Texts.CssClass(p.Severity)">@Texts.Problem(p)@if (p.Detail is not null) {<small>@p.Detail</small>}</div>
    }

    <form method="post" class="card">
        <input type="hidden" name="Step" value="@Model.Step">
        @switch (Model.Step)
        {
            case 1:
                <p>@Strings.Setup_Welcome</p>
                <label for="Language">@Strings.Setup_Language</label>
                <select asp-for="Language">
                    <option value="fr" selected="@(Model.Language != "en")">Français</option>
                    <option value="en" selected="@(Model.Language == "en")">English</option>
                </select>
                <button type="submit" asp-page-handler="Language">@Strings.Setup_Next</button>
                break;
            case 2:
                <label for="BusinessName">@Strings.Setup_BusinessName</label>
                <input asp-for="BusinessName" maxlength="80" required>
                <label for="WifiName">@Strings.Setup_WifiName</label>
                <input asp-for="WifiName" maxlength="32">
                <p class="muted">@Strings.Setup_WifiNameHelp</p>
                <button type="submit" asp-page-handler="Business">@Strings.Setup_Next</button>
                break;
            case 3:
                <p>@Strings.Setup_PasswordIntro</p>
                <p>@Strings.Portal_Username : <code>admin</code></p>
                <label for="Password">@Strings.Password_New</label>
                <input asp-for="Password" type="password" autocomplete="new-password" required>
                <p class="muted">@string.Format(Strings.Password_Rule, StonesHotspot.Core.Services.StaffService.MinPasswordLength)</p>
                <label for="Confirm">@Strings.Password_Confirm</label>
                <input asp-for="Confirm" type="password" autocomplete="new-password" required>
                <button type="submit" asp-page-handler="Password">@Strings.Setup_Next</button>
                break;
            case 4:
                var o = Model.Network!;
                <p>@Strings.Setup_NetworkIntro</p>
                <label for="WanId">@Strings.Network_Wan</label>
                <select asp-for="WanId">
                    <option value="">@Strings.Network_Choose</option>
                    @foreach (var a in o.Adapters)
                    {
                        <option value="@a.Id" selected="@(a.Id == Model.WanId)">@a.Name — @a.Description@(a.Id == o.Suggestion.Wan?.Id ? $" ({Strings.Network_Suggested})" : "")</option>
                    }
                </select>
                <label for="LanId">@Strings.Network_Lan</label>
                <select asp-for="LanId">
                    <option value="">@Strings.Network_Choose</option>
                    @foreach (var a in o.Suggestion.LanCandidates)
                    {
                        <option value="@a.Id" selected="@(a.Id == Model.LanId)">@a.Name — @a.Description@(a.IsMobileHotspot ? $" ({Strings.Network_HotspotAdapter})" : "")</option>
                    }
                </select>
                <button type="submit" asp-page-handler="Network">@Strings.Network_Apply</button>
                <a href="/setup?step=5">@Strings.Setup_Later</a>
                break;
            case 5:
                <p>@Strings.Setup_PlansIntro</p>
                <table>
                    <tr><th>@Strings.Col_Name</th><th>@Strings.Col_Price (FCFA)</th></tr>
                    @foreach (var t in Model.Tariffs)
                    {
                        <tr>
                            <td>@t.Name<div class="muted">@StonesHotspot.Web.Admin.AdminText.Describe(t, culture)</div></td>
                            <td><input name="@(SetupModel.PricePrefix)@t.Id" value="@t.Price.Amount" inputmode="numeric" required aria-label="@t.Name"></td>
                        </tr>
                    }
                </table>
                <button type="submit" asp-page-handler="Prices">@Strings.Setup_Next</button>
                break;
            default:
                <p>@Strings.Setup_Ready</p>
                <ul>
                    @foreach (var t in Model.Tariffs)
                    {
                        <li>@t.Name — @t.Price</li>
                    }
                </ul>
                <button type="submit" asp-page-handler="Finish">@Strings.Setup_Finish</button>
                break;
        }
    </form>
    @if (Model.Step > 1)
    {
        <p><a href="/setup?step=@(Model.Step - 1)">← @Strings.Setup_Back</a></p>
    }
</div>
