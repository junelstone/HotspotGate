@using StonesHotspot.Web.Admin
@using StonesHotspot.Web.Auth
@using StonesHotspot.Licensing
@inject ILicenseService Licence
@inject TimeProvider Clock
@inject StonesHotspot.Licensing.Online.UpdateStatus Updates
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var path = Context.Request.Path;
    var user = Context.User;
    var signedIn = user.Identity?.IsAuthenticated == true && user.FindFirst(StaffClaims.MustChangePassword)?.Value != "1";
    var admin = user.IsAdmin();
    var licence = signedIn ? Licence.GetStatus() : null;
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    string Day(DateTimeOffset? d) => d?.ToLocalTime().ToString("D", culture) ?? "";
    string Active(string href) => path.StartsWithSegments(href) && (href != "/admin" || path == "/admin" || path == "/admin/") ? "active" : "";
}
<!doctype html>
<html lang="@lang">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    @await RenderSectionAsync("Head", required: false)
    <title>@ViewData["Title"] — @Strings.AppName</title>
    <style>
        :root { --bg:#f6f7f9; --fg:#1d2330; --muted:#5d6675; --card:#fff; --line:#dde1e7; --accent:#0b6e4f;
                --error:#b42318; --error-bg:#fdecea; --warn:#8a5a00; --warn-bg:#fff4dc; --ok:#0b6e4f; --ok-bg:#e6f4ee; }
        * { box-sizing:border-box; }
        body { margin:0; font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; background:var(--bg); color:var(--fg); }
        header { background:var(--accent); color:#fff; padding:.6rem 1rem; display:flex; flex-wrap:wrap; gap:.4rem 1rem; align-items:center; }
        header a { color:#fff; text-decoration:none; }
        header nav { display:flex; gap:.2rem .9rem; flex-wrap:wrap; flex:1; font-size:.95rem; }
        header nav a { opacity:.85; padding:.15rem 0; } header nav a.active { opacity:1; border-bottom:2px solid #fff; }
        header .who { display:flex; gap:.6rem; align-items:center; font-size:.9rem; }
        header .who button { margin:0; padding:.2rem .6rem; font-size:.85rem; background:transparent; border:1px solid #fff; }
        header .lang a { opacity:.8; margin-left:.4rem; }
        main { max-width:1150px; margin:0 auto; padding:1rem; }
        h1 { font-size:1.4rem; } h2 { font-size:1.1rem; margin-top:1.5rem; }
        .card { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:1rem; margin:1rem 0; }
        .cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:.8rem; }
        .cards > .card { margin:0; }
        .cards { margin:1rem 0; }
        .stat { font-size:1.6rem; font-weight:700; font-variant-numeric:tabular-nums; }
        table { width:100%; border-collapse:collapse; background:var(--card); }
        th, td { text-align:left; padding:.45rem .5rem; border-bottom:1px solid var(--line); vertical-align:top; }
        th { font-size:.85rem; color:var(--muted); }
        td.num, th.num { text-align:right; font-variant-numeric:tabular-nums; }
        .scroll { overflow-x:auto; }
        .muted { color:var(--muted); font-size:.9rem; }
        .badge { display:inline-block; font-size:.75rem; padding:.1rem .4rem; border-radius:4px; background:#eef0f3; }
        .msg { padding:.6rem .8rem; border-radius:6px; margin:.5rem 0; }
        .msg.error { background:var(--error-bg); color:var(--error); }
        .msg.warning { background:var(--warn-bg); color:var(--warn); }
        .msg.info, .msg.ok { background:var(--ok-bg); color:var(--ok); }
        .msg small { display:block; opacity:.8; margin-top:.2rem; word-break:break-word; }
        label { display:block; font-weight:600; margin:.7rem 0 .25rem; }
        input[type=text], input[type=password], input[type=tel], input[type=number], input[type=date], input[type=url], input[type=color], input[type=file], select, textarea {
            width:100%; max-width:520px; padding:.5rem; font-size:1rem; border:1px solid #b8c0cc; border-radius:6px; background:#fff; }
        textarea { min-height:9rem; max-width:100%; }
        input.small, select.small { width:auto; display:inline-block; }
        .row { display:flex; flex-wrap:wrap; gap:0 1.2rem; } .row > div { min-width:min(200px, 100%); flex:1; }
        button, a.button { display:inline-block; padding:.55rem 1rem; font-size:1rem; border-radius:6px; border:1px solid var(--accent);
                           background:var(--accent); color:#fff; cursor:pointer; margin:.8rem .5rem 0 0; text-decoration:none; }
        button.secondary, a.button.secondary { background:#fff; color:var(--accent); }
        button.danger { background:#fff; color:var(--error); border-color:var(--error); }
        button.link { background:none; border:0; color:var(--accent); padding:0; margin:0; text-decoration:underline; font-size:.95rem; }
        td form { display:inline; } td button { margin:.1rem .2rem .1rem 0; padding:.3rem .6rem; font-size:.9rem; }
        code { font-size:.9rem; }
        .code { font-family:ui-monospace,Consolas,monospace; letter-spacing:.05em; }
        @@media (max-width: 760px) {
            /* Phone: name + sign-out on the first line, the menu as a wrapping row below. */
            header nav { order:3; flex-basis:100%; gap:.15rem .8rem; }
            header .who { margin-left:auto; }
            main { padding:.75rem; }
        }
        @@media print { header, .noprint { display:none !important; } }
    </style>
</head>
<body>
<header>
    <strong>@Strings.AppName</strong>
    <nav>
        @if (signedIn)
        {
            <a class="@Active("/admin")" href="/admin">@Strings.Nav_Home</a>
            <a class="@Active("/admin/till")" href="/admin/till">@Strings.Nav_Till</a>
            <a class="@Active("/admin/sell")" href="/admin/sell">@Strings.Nav_Sell</a>
            <a class="@Active("/admin/shift")" href="/admin/shift">@Strings.Nav_Shift</a>
            <a class="@Active("/admin/accounts")" href="/admin/accounts">@Strings.Nav_Accounts</a>
            @if (admin)
            {
                <a class="@Active("/admin/live")" href="/admin/live">@Strings.Nav_Live</a>
                <a class="@Active("/admin/tariffs")" href="/admin/tariffs">@Strings.Nav_Tariffs</a>
                <a class="@Active("/admin/vouchers")" href="/admin/vouchers">@Strings.Nav_Vouchers</a>
                <a class="@Active("/admin/products")" href="/admin/products">@Strings.Nav_Products</a>
                <a class="@Active("/admin/reports")" href="/admin/reports">@Strings.Nav_Reports</a>
                <a class="@Active("/admin/access")" href="/admin/access">@Strings.Nav_Access</a>
                <a class="@Active("/admin/payments")" href="/admin/payments">@Strings.Nav_Payments</a>
                <a class="@Active("/admin/filter")" href="/admin/filter">@Strings.Nav_Filter</a>
                <a class="@Active("/admin/bandwidth")" href="/admin/bandwidth">@Strings.Nav_Bandwidth</a>
                <a class="@Active("/admin/staff")" href="/admin/staff">@Strings.Nav_Staff</a>
                <a class="@Active("/admin/settings")" href="/admin/settings">@Strings.Nav_Settings</a>
                <a class="@Active("/admin/audit")" href="/admin/audit">@Strings.Nav_Audit</a>
                <a class="@Active("/admin/backup")" href="/admin/backup">@Strings.Nav_Backup</a>
                <a class="@Active("/admin/licence")" href="/admin/licence">@Strings.Nav_Licence</a>
                <a class="@Active("/admin/network")" href="/admin/network">@Strings.Nav_Network</a>
                <a class="@Active("/admin/devices")" href="/admin/devices">@Strings.Nav_Devices</a>
                <a class="@Active("/admin/gate")" href="/admin/gate">@Strings.Nav_Gate</a>
            }
        }
    </nav>
    <span class="who">
        @if (user.Identity?.IsAuthenticated == true)
        {
            <span>@user.Identity.Name</span>
            <form method="post" action="/admin/logout"><button type="submit">@Strings.Nav_Logout</button>@Html.AntiForgeryToken()</form>
        }
        <span class="lang"><a href="@path?lang=fr">FR</a><a href="@path?lang=en">EN</a></span>
    </span>
</header>
<main>
    @if (licence is not null)
    {
        @if (licence.Stopped)
        {
            <div class="msg error"><strong>@Strings.Licence_BannerStopped</strong> <a href="/admin/licence">@Strings.Licence_Activate</a></div>
        }
        else if (licence.InGracePeriod)
        {
            <div class="msg error">@string.Format(licence.RevokedAt is null ? Strings.Licence_BannerGrace : Strings.Licence_BannerRevoked, Day(licence.StopsAt)) <a href="/admin/licence">@Strings.Licence_Activate</a></div>
        }
        else if (licence.WarningDaysLeft is { } left)
        {
            <div class="msg warning">@string.Format(licence.Kind == LicenceKind.Trial ? Strings.Licence_BannerTrialEnds : Strings.Licence_BannerEnds, left, Day(licence.ExpiresAt?.AddDays(-1))) <a href="/admin/licence">@Strings.Nav_Licence</a></div>
        }
        @if (licence.ClockProblem)
        {
            <div class="msg warning">@Strings.Licence_BannerClock</div>
        }
        @if (admin && Updates.Available is { } update)
        {
            <div class="msg ok">@string.Format(Strings.Update_Banner, StonesHotspot.Licensing.Online.AppVersion.Display(update.Version)) @update.Notes</div>
        }
    }
    @if (TempData[Flash.SuccessKey] is string ok)
    {
        <div class="msg ok">@ok</div>
    }
    @if (TempData[Flash.ErrorKey] is string error)
    {
        <div class="msg error">@error</div>
    }
    @RenderBody()
</main>
<script>
// Buttons with data-confirm ask before submitting (deleting, disabling, restoring…).
document.addEventListener('click', function (e) {
    var b = e.target.closest ? e.target.closest('[data-confirm]') : null;
    if (b && !window.confirm(b.getAttribute('data-confirm'))) e.preventDefault();
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
