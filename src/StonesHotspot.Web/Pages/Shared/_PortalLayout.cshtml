@using StonesHotspot.Web.Portal
@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var path = Context.Request.Path;
    var keep = string.Join("&", Context.Request.Query.Where(q => q.Key != "lang")
        .Select(q => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(q.Value.ToString())}"));
    var sep = keep.Length > 0 ? "&" : "";
    var brand = ViewData[PortalBranding.ViewDataKey] as PortalBranding;
}
<!doctype html>
<html lang="@lang">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    @await RenderSectionAsync("Head", required: false)
    <title>@ViewData["Title"]</title>
    @* Everything inline: the customer has no internet yet, so no CDN, no external file. *@
    <style>
        :root { --bg:#f4f6f8; --fg:#17202b; --muted:#5d6675; --card:#fff; --accent:@(brand?.AccentColor ?? PortalBranding.DefaultAccent); --line:#dde1e7;
                --error:#b42318; --error-bg:#fdecea; --info-bg:#eef4ff; --info:#1d4ed8; }
        * { box-sizing:border-box; }
        body { margin:0; font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; background:var(--bg); color:var(--fg); font-size:16px; }
        main { max-width:460px; margin:0 auto; padding:1rem 1rem 2rem; }
        .top { display:flex; justify-content:space-between; align-items:center; gap:1rem; }
        .brand { display:flex; align-items:center; gap:.6rem; font-weight:700; font-size:1.05rem; }
        .brand img { max-height:44px; max-width:140px; }
        .lang a { color:var(--accent); margin-left:.6rem; text-decoration:none; font-size:.9rem; }
        h1 { font-size:1.3rem; margin:1.2rem 0 .8rem; }
        .card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:1.1rem; margin:1rem 0; }
        label { display:block; font-weight:600; margin:.2rem 0 .4rem; }
        input[type=text], input[type=password] { width:100%; font-size:1.15rem; padding:.75rem; border:1px solid #b8c0cc; border-radius:8px; }
        input.code { text-transform:uppercase; letter-spacing:.15em; text-align:center; font-size:1.4rem; font-family:ui-monospace,Consolas,monospace; }
        .hint { color:var(--muted); font-size:.85rem; margin:.35rem 0 0; }
        button, a.button { display:block; width:100%; text-align:center; background:var(--accent); color:#fff; border:0; padding:.85rem;
                           border-radius:8px; font-size:1.05rem; font-weight:600; margin-top:1rem; cursor:pointer; text-decoration:none; }
        button.secondary { background:#fff; color:var(--accent); border:1px solid var(--accent); }
        details summary { cursor:pointer; color:var(--accent); font-weight:600; }
        .msg { padding:.7rem .8rem; border-radius:8px; margin:.8rem 0; }
        .msg.error { background:var(--error-bg); color:var(--error); }
        .msg.info { background:var(--info-bg); color:var(--info); }
        .ok { color:var(--accent); font-weight:700; }
        .muted { color:var(--muted); font-size:.85rem; word-break:break-word; }
        .big { font-size:2rem; font-weight:700; font-variant-numeric:tabular-nums; }
        dl { display:grid; grid-template-columns:auto 1fr; gap:.45rem 1rem; margin:0; }
        dt { color:var(--muted); } dd { margin:0; text-align:right; font-weight:600; font-variant-numeric:tabular-nums; }
        a { color:var(--accent); }
    </style>
</head>
<body>
<main>
    <div class="top">
        <div class="brand">
            @if (brand?.HasLogo == true) { <img src="/portal/logo" alt=""> }
            <span>@brand?.BusinessName</span>
        </div>
        <div class="lang"><a href="@path?@keep@(sep)lang=fr">FR</a><a href="@path?@keep@(sep)lang=en">EN</a></div>
    </div>
    @RenderBody()
</main>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
