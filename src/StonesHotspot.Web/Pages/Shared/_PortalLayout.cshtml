@{
    var lang = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var path = Context.Request.Path;
    var query = Context.Request.Query.Where(q => q.Key != "lang").Select(q => $"{q.Key}={Uri.EscapeDataString(q.Value.ToString())}");
    var keep = string.Join("&", query);
    var sep = keep.Length > 0 ? "&" : "";
}
<!doctype html>
<html lang="@lang">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    @* Everything inline: the customer has no internet yet, so no CDN, no external file. *@
    <style>
        :root { --bg:#f4f6f8; --fg:#17202b; --muted:#5d6675; --card:#fff; --accent:#0b6e4f; --line:#dde1e7; }
        * { box-sizing:border-box; }
        body { margin:0; font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; background:var(--bg); color:var(--fg); }
        main { max-width:460px; margin:0 auto; padding:1.25rem 1rem 2rem; }
        .lang { text-align:right; font-size:.9rem; } .lang a { color:var(--accent); margin-left:.6rem; text-decoration:none; }
        h1 { font-size:1.35rem; margin:.5rem 0 1rem; }
        .card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:1.1rem; margin:1rem 0; }
        .ok { color:var(--accent); font-weight:600; }
        .muted { color:var(--muted); font-size:.85rem; word-break:break-all; }
        a.button { display:block; text-align:center; background:var(--accent); color:#fff; padding:.8rem; border-radius:8px; text-decoration:none; font-weight:600; }
    </style>
</head>
<body>
<main>
    <div class="lang"><a href="@path?@keep@(sep)lang=fr">FR</a><a href="@path?@keep@(sep)lang=en">EN</a></div>
    @RenderBody()
</main>
</body>
</html>
