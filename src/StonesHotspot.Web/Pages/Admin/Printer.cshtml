@page "/admin/printer"
@model StonesHotspot.Web.Pages.Admin.PrinterModel
@{
    ViewData["Title"] = Strings.Nav_Printer;
}
<h1>@Strings.Nav_Printer</h1>
<p class="muted">@Strings.Printer_Intro</p>
<form method="post" class="card">
    <label for="Connection">@Strings.Printer_Connection</label>
    <input asp-for="Connection" type="text" list="printers" placeholder="192.168.137.50:9100 · COM3:9600 · POS-80" autocomplete="off">
    <datalist id="printers">
        @foreach (var name in Model.InstalledPrinters) { <option value="@name"></option> }
    </datalist>
    <p class="muted"><strong>@StonesHotspot.Web.Pages.Admin.PrinterModel.Describe(Model.Parsed)</strong><br>@Strings.Printer_ConnectionHelp</p>
    @if (Model.InstalledPrinters.Count > 0)
    {
        <p class="muted">@Strings.Printer_Installed : @string.Join(" · ", Model.InstalledPrinters)</p>
    }
    <div class="row">
        <div>
            <label for="PaperWidth">@Strings.Printer_Paper</label>
            <select asp-for="PaperWidth"><option value="80">80 mm (48 @Strings.Printer_Characters)</option><option value="58">58 mm (32 @Strings.Printer_Characters)</option></select>
        </div>
        <div>
            <label for="Charset">@Strings.Printer_Charset</label>
            <select asp-for="Charset"><option value="pc850">PC850 (é, è, à, ç)</option><option value="ascii">ASCII (@Strings.Printer_NoAccents)</option></select>
        </div>
    </div>
    <p class="muted">@Strings.Printer_CharsetHelp</p>
    <label><input asp-for="Qr" type="checkbox"> @Strings.Printer_Qr</label>
    <label><input asp-for="AutoSale" type="checkbox"> @Strings.Printer_AutoSale</label>
    <label><input asp-for="AutoShift" type="checkbox"> @Strings.Printer_AutoShift</label>
    <label for="Header">@Strings.Printer_Header</label>
    <textarea asp-for="Header" maxlength="300" style="min-height:4.5rem" placeholder="Avenue de la Paix, Brazzaville · Tél. 06 000 00 00 · NIU …"></textarea>
    <label for="Footer">@Strings.Printer_Footer</label>
    <textarea asp-for="Footer" maxlength="300" style="min-height:3.5rem"></textarea>
    <button type="submit">@Strings.Common_Save</button>
</form>
<form method="post" asp-page-handler="Test">
    <button type="submit" class="secondary">@Strings.Printer_Test</button>
</form>
<p class="muted">@Strings.Printer_TestHelp</p>
