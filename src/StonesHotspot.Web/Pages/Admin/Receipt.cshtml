@page "/admin/receipt"
@model StonesHotspot.Web.Pages.Admin.ReceiptModel
@using StonesHotspot.Core.Rules
@using StonesHotspot.Web.Admin
@using StonesHotspot.Web.Documents
@{
    ViewData["Title"] = $"{Strings.Print_Receipt} {Model.Receipt.Number}";
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    var r = Model.Receipt;
    var n = Uri.EscapeDataString(r.Number);
}
@section Head {
<style>
    .receipt { max-width:80mm; margin:1rem auto; background:#fff; border:1px solid var(--line); padding:5mm 4mm; font-size:10pt; color:#000; }
    .receipt .c { text-align:center; } .receipt .biz { font-weight:700; font-size:13pt; }
    .receipt table { background:none; } .receipt td { padding:.15rem 0; border:0; }
    .receipt hr { border:0; border-top:1px dashed #000; margin:2mm 0; }
    .receipt .code { font-size:16pt; font-weight:700; margin:1mm 0; }
    .receipt svg { display:block; margin:1mm auto; }
    @@media print { @@page { size:88mm auto; margin:3mm; } body { background:#fff; } main { padding:0; } .receipt { border:0; margin:0; } }
</style>
}
<div class="noprint">
    <h1>@ViewData["Title"]</h1>
    <button type="button" onclick="window.print()">@Strings.Print_Print</button>
    @if (Model.HasPrinter)
    {
        <form method="post" asp-page-handler="Thermal" asp-route-n="@r.Number" style="display:inline"><button type="submit">@Strings.Receipt_PrintThermal</button></form>
    }
    <a class="button secondary" href="/admin/receipt?handler=Pdf&n=@n">PDF</a>
    <a class="button secondary" href="/admin/till">@Strings.Nav_Till</a>
</div>

<div class="receipt">
    <div class="c biz">@Model.Brand.BusinessName</div>
    @if (!string.IsNullOrWhiteSpace(Model.Brand.Header)) { <div class="c" style="white-space:pre-line">@Model.Brand.Header</div> }
    <hr>
    <div><strong>@Strings.Print_Receipt @r.Number</strong></div>
    <div>@AdminText.Date(r.Timestamp, culture)</div>
    @if (r.Seller is not null) { <div>@Strings.Print_Seller : @r.Seller</div> }
    <hr>
    <table>
        @foreach (var line in r.Lines)
        {
            <tr><td>@ReceiptLayouts.LineLabel(line)
                    @if (line.Quantity > 1) { <br><small>@line.Quantity × @line.UnitPrice</small> }</td>
                <td class="num">@line.Amount</td></tr>
        }
    </table>
    <hr>
    <table>
        <tr><td><strong>@Strings.Print_Total.ToUpper(culture)</strong></td><td class="num"><strong style="font-size:12pt">@r.Total</strong></td></tr>
        <tr><td colspan="2">@Strings.Sell_Payment : @AdminText.Payment(r.Method)</td></tr>
        @foreach (var vat in r.Vat)
        {
            <tr><td><small>@string.Format(culture, Strings.Receipt_VatIncluded, ReceiptLayouts.Percent(vat.Rate, culture))</small></td><td class="num"><small>@vat.Vat</small></td></tr>
        }
    </table>
    @foreach (var v in r.Vouchers)
    {
        <hr>
        <div class="c">
            @if (!string.IsNullOrEmpty(Model.Brand.WifiName)) { <div>Wi-Fi : <strong>@Model.Brand.WifiName</strong></div> }
            <div><strong>@v.Tariff.Name</strong> — @AdminText.Describe(v.Tariff, culture)</div>
            <div class="code">@VoucherCodeGenerator.Format(v.Code)</div>
            @Html.Raw(QrSvg.Render(Model.Brand.CodeLink(v.Code), 28))
            <small>@Strings.Print_HowTo<br>@Model.Brand.PortalAddress</small>
        </div>
    }
    <hr>
    @if (!string.IsNullOrWhiteSpace(Model.Brand.Footer)) { <div class="c" style="white-space:pre-line">@Model.Brand.Footer</div> }
    <div class="c">@Strings.Print_Thanks</div>
</div>
