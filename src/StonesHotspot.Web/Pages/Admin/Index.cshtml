@page
@model StonesHotspot.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = Strings.Admin_Home_Title;
    var admin = Model.Me.Role == StonesHotspot.Core.Data.Entities.StaffRole.Admin;
}
<h1>@Strings.Admin_Home_Title</h1>
@if (Model.TrialDaysLeft is { } days)
{
    <p class="muted">@string.Format(Strings.Licence_TrialDaysLeft, days)</p>
}

@if (Model.PasswordOfTheDay is not null)
{
    <div class="msg ok">@Strings.Home_PasswordOfTheDay <strong class="code" style="font-size:1.3rem">@Model.PasswordOfTheDay</strong></div>
}

<div class="cards">
    <div class="card">
        <div class="muted">@(admin ? Strings.Home_SalesToday : Strings.Home_MySalesToday)</div>
        <div class="stat">@Model.SalesToday</div>
        <div class="muted">@string.Format(Strings.Home_Transactions, Model.SalesCountToday)</div>
    </div>
    <div class="card">
        <div class="muted">@Strings.Home_Online</div>
        <div class="stat">@Model.ActiveSessions</div>
        @if (admin) { <a href="/admin/live">@Strings.Nav_Live</a> }
    </div>
    <div class="card">
        <div class="muted">@Strings.Home_DevicesOnWifi</div>
        <div class="stat">@Model.ConnectedDevices</div>
    </div>
    @if (Model.ShiftsEnabled)
    {
        <div class="card">
            <div class="muted">@Strings.Nav_Shift</div>
            <div class="stat" style="font-size:1.1rem">@(Model.OpenShift is null ? Strings.Shift_None : Strings.Shift_Open)</div>
            <a href="/admin/shift">@(Model.OpenShift is null ? Strings.Shift_OpenAction : Strings.Shift_View)</a>
        </div>
    }
</div>

<a class="button" href="/admin/sell">@Strings.Nav_Sell</a>
<a class="button secondary" href="/admin/accounts">@Strings.Nav_Accounts</a>
