@page "/admin/password"
@model StonesHotspot.Web.Pages.Admin.PasswordModel
@{
    ViewData["Title"] = Strings.Password_Title;
}
<div style="max-width:460px;margin:1rem auto">
    <h1>@Strings.Password_Title</h1>
    @if (Model.Forced)
    {
        <div class="msg warning">@Strings.Password_MustChange</div>
    }
    @if (Model.Error is not null)
    {
        <div class="msg error" role="alert">@Model.Error</div>
    }
    <form method="post" class="card">
        <label for="Current">@Strings.Password_Current</label>
        <input asp-for="Current" type="password" autocomplete="current-password">
        <label for="New">@Strings.Password_New</label>
        <input asp-for="New" type="password" autocomplete="new-password">
        <p class="muted">@string.Format(Strings.Password_Rule, StonesHotspot.Core.Services.StaffService.MinPasswordLength)</p>
        <label for="Confirm">@Strings.Password_Confirm</label>
        <input asp-for="Confirm" type="password" autocomplete="new-password">
        <button type="submit">@Strings.Common_Save</button>
    </form>
</div>
