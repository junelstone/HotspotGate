@page "/admin/print"
@model StonesHotspot.Web.Pages.Admin.PrintModel
@using StonesHotspot.Core.Rules
@using StonesHotspot.Web.Admin
@{
    Layout = null;
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    var lang = culture.TwoLetterISOLanguageName;
}
<!doctype html>
<html lang="@lang">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@Strings.Print_Title</title>
    <style>
        * { box-sizing:border-box; }
        body { margin:0; font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; color:#000; background:#fff; }
        .tools { padding:.8rem; background:#f1f3f5; display:flex; gap:.6rem; flex-wrap:wrap; align-items:center; }
        .tools a, .tools button { padding:.45rem .8rem; border:1px solid #0b6e4f; border-radius:6px; background:#fff; color:#0b6e4f; text-decoration:none; font-size:.95rem; cursor:pointer; }
        .tools button.print { background:#0b6e4f; color:#fff; }
        .code { font-family:ui-monospace,Consolas,monospace; font-weight:700; letter-spacing:.08em; }
        .small { font-size:.75em; }
        @@page { size:A4; margin:8mm; }
        .sheet { display:grid; grid-template-columns:repeat(3, 1fr); gap:3mm; padding:8mm; }
        .card { border:1px dashed #888; border-radius:2mm; padding:2.5mm; height:42mm; display:flex; gap:2mm; break-inside:avoid; overflow:hidden; }
        .card .text { flex:1; min-width:0; font-size:8.5pt; line-height:1.25; }
        .card .biz { font-weight:700; font-size:9.5pt; }
        .card .plan { font-weight:700; margin-top:1mm; }
        .card .code { font-size:12.5pt; margin-top:1.5mm; }
        .receipt { padding:0 8mm 8mm; font-size:10pt; }
        @@media (max-width: 700px) { .sheet { grid-template-columns:1fr; } }
        @@media print { .tools { display:none; } .sheet { padding:0; grid-template-columns:repeat(3, 1fr); } .receipt { padding:3mm 0 0; } }
    </style>
</head>
<body>
<div class="tools">
    <button class="print" onclick="window.print()">@Strings.Print_Print</button>
    <a href="@(Model.Receipt is not null ? "/admin/sell" : "/admin/vouchers")">@Strings.Portal_Back</a>
</div>

<div class="sheet">
@foreach (var v in Model.Vouchers)
{
    <div class="card">
        <div class="text">
            <div class="biz">@Model.BusinessName</div>
            @if (!string.IsNullOrEmpty(Model.WifiName)) { <div class="small">Wi-Fi : @Model.WifiName</div> }
            <div class="plan">@v.Tariff.Name — @v.Tariff.Price</div>
            <div class="small">@AdminText.Describe(v.Tariff, culture)</div>
            <div class="code">@VoucherCodeGenerator.Format(v.Code)</div>
            <div class="small">@Strings.Print_HowTo</div>
            <div class="small">@Model.PortalAddress</div>
        </div>
        @Html.Raw(QrSvg.Render(Model.PortalLink(v), 24))
    </div>
}
</div>

@if (Model.Sale is not null)
{
    <div class="receipt">
        @Strings.Print_Receipt @Model.Sale.ReceiptNumber · @AdminText.Date(Model.Sale.Timestamp, culture) · @AdminText.Payment(Model.Sale.PaymentMethod)
        · <strong>@Strings.Print_Total : @Model.Total</strong>
        @if (Model.Seller is not null) { <span> · @Strings.Print_Seller : @Model.Seller</span> }
    </div>
}
</body>
</html>
